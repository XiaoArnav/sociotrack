# ==============================================================================
# SocioTrack: Autonomous AI Social Media Engagement & Intelligence Agent
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Paste your actual API keys into the corresponding fields below.
# 3. '.env' is strictly gitignored to guarantee zero secret leaks.
# ==============================================================================

# Application & Server Runtime
APP_ENV=development
APP_NAME=SocioTrack
API_V1_STR=/api
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Database & Supabase Settings
# Local SQLite default: sqlite+aiosqlite:///./sociotrack.db
# PostgreSQL / Supabase: postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./sociotrack.db
SYNC_DATABASE_URL=sqlite:///./sociotrack.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vector Store Settings (ChromaDB or pgvector)
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_data

# ==============================================================================
# FREE AI MODEL PROVIDERS (Add your key to activate content prediction & audits)
# ==============================================================================

# Google Gemini API (Recommended Free Multimodal Tier: 1,500 req/day)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq Cloud API (Free Ultra-Fast Llama-3.3-70B & Whisper Audio Transcription)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (Optional)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection
DEFAULT_MODEL=gemini-1.5-flash

# ==============================================================================
# INSTAGRAM / META GRAPH API & CRAWLER SETTINGS
# ==============================================================================

# Meta / Instagram Graph API Webhook Verification Token
META_VERIFY_TOKEN=sociotrack_meta_verify_token_2026
META_APP_SECRET=your_meta_app_secret_here

# Official Instagram Business Discovery / Graph API Access Token (Optional)
# Requires an Instagram Professional/Creator account connected to a Facebook Page.
# Allows 100% legal, rate-limit-protected querying of public creator media.
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# RapidAPI Instagram Scraper Key (Optional fallback for headless scraping)
# Get free calls on RapidAPI: e.g. 'instagram-scraper-api2'
RAPIDAPI_KEY=your_rapidapi_key_here

# ==============================================================================
# SOCIAL ENGAGEMENT SCORING & ANOMALY WEIGHTS
# ==============================================================================
MIN_COMPOSITE_SCORE_THRESHOLD=5.0
WEIGHT_SHARES=3.0
WEIGHT_REPLIES=2.0
WEIGHT_LIKES=1.0

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# SocioTrack: Production-Hardened Environment Configuration Template
# ==============================================================================
#
# INSTRUCTIONS:
# 1. In Local Development:
#      cp .env.example .env
# 2. In Production (Render, Railway, Fly.io, Vercel, Docker):
#      Configure these variables securely in your host environment console.
#      Never commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY PRODUCTION VARIABLES (Application startup validates these)
# ------------------------------------------------------------------------------

# Environment: 'production' or 'development'
ENVIRONMENT=development
APP_ENV=development

# Debug Mode: MUST be 'false' in production. (True only in local dev)
DEBUG=true

# Application Name & Port
APP_NAME=SocioTrack
PORT=8000
HOST=0.0.0.0
API_V1_STR=/api

# Cryptographically Secure JWT Secret Key (HS256)
# In production, this MUST be at least 32 characters long and randomly generated.
# Generate via: openssl rand -hex 32
SECRET_KEY=your_cryptographically_secure_random_secret_key_at_least_32_chars_long

# JWT Session Lifespan
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
# IN PRODUCTION: Specify explicit trusted domains as a JSON array of strings.
# Wildcard '*' is strictly blocked in production when credentials are supported.
# Example: CORS_ORIGINS=["https://frontend-taupe-zeta-84.vercel.app","https://sociotrack.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://frontend-taupe-zeta-84.vercel.app"]

# Database Connection URL
# Local Dev Default: sqlite+aiosqlite:///./sociotrack.db
# Production (Supabase / Neon / Render Postgres):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_HOST.supabase.co:5432/postgres
# SYNC_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_HOST.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./sociotrack.db
SYNC_DATABASE_URL=sqlite:///./sociotrack.db

# Demo Sandbox Mode
# Strictly set to 'false' in production to disable public demo guest logins.
ENABLE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. SOCIAL MEDIA & META GRAPH API INTEGRATION (Optional / Gated)
# ------------------------------------------------------------------------------

# Meta / Instagram Graph API Webhook Verification Token
# In production, set to a unique secret token configured in Meta App Dashboard.
# Do NOT use known default tokens.
META_VERIFY_TOKEN=your_custom_meta_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here

# Instagram Graph API Access Tokens
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_SESSIONID=your_sessionid_cookie_for_development_scraping_only

# RapidAPI Scraper Key (Optional fallback)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=instagram-scraper-stable-api.p.rapidapi.com

# ------------------------------------------------------------------------------
# 3. AI MODEL PROVIDERS (Configurable / Multi-provider with graceful fallback)
# ------------------------------------------------------------------------------

# Preferred provider: 'auto' (default: Gemini -> Groq -> OpenAI), 'gemini', 'groq', 'openai'
AI_PROVIDER=auto

# Google Gemini API (Recommended Tier: fast and structured)
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud API (Ultra-low latency open models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. STRIPE PAYMENT & SUBSCRIPTION BILLING (Optional / Fails safely)
# ------------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
FRONTEND_URL=https://frontend-taupe-zeta-84.vercel.app

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------

# Base URL for frontend requests to backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

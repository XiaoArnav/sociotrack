# ==========================================
# SocioTrack: Social Media Engagement Agent
# Environment Configuration Template
# ==========================================

# Application Settings
APP_ENV=development
APP_NAME=SocioTrack
API_V1_STR=/api
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Supabase Settings
# For local SQLite development (default): sqlite:///./sociotrack.db
# For Supabase / PostgreSQL: postgresql+psycopg2://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite:///./sociotrack.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vector Store Settings
# CHROMA or PGVECTOR
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_data

# LLM Providers (Optional for testing, enabled for production)
OPENAI_API_KEY=sk-placeholder-openai-key
ANTHROPIC_API_KEY=sk-placeholder-anthropic-key
GOOGLE_API_KEY=placeholder-google-api-key
DEFAULT_MODEL=gemini-1.5-pro

# Social Engagement Thresholds
MIN_COMPOSITE_SCORE_THRESHOLD=5.0
WEIGHT_SHARES=3.0
WEIGHT_REPLIES=2.0
WEIGHT_LIKES=1.0

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

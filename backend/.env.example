# SocioTrack Backend Configuration

# Server
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL for production/docker, SQLite for quick local test)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sociotrack
DATABASE_URL=sqlite+aiosqlite:///./sociotrack.db
SYNC_DATABASE_URL=sqlite:///./sociotrack.db

# Hindsight Agent Memory (Vectorize.io)
# Use local Docker server or Hindsight Cloud (https://ui.hindsight.vectorize.io)
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=sociotrack

# Optional LLM API Keys (Groq / OpenAI)
GROQ_API_KEY=
OPENAI_API_KEY=
